# Copy to .env.local and fill in from your Supabase project settings.
# Both values are public by design — they ship in the browser bundle, and
# row-level security is what enforces who can read what.
# Never put the service_role key in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
