# Copy to .env.local and fill in from your Supabase project settings.
# Both values are public by design — they ship in the browser bundle, and
# row-level security is what enforces who can read what.
# Never put the service_role key in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Everything below is SERVER-ONLY.
#
# None of it is ever prefixed with VITE_, read from browser code, written into
# a connector YAML, or committed with a value. These are Supabase Edge Function
# secrets: set them with `npx supabase@latest secrets set NAME=value
# --project-ref <ref>`, or in the project's Edge Functions settings.
#
# Leave every line here empty. This file is the inventory of names, not a place
# for values.
# ---------------------------------------------------------------------------

# --------------------------------------------------------------- the lanes
#
# Four workflows, four independent deployments. Each has its own trigger URL
# and its own secret and they are NOT interchangeable — pasting one workflow's
# secret against another's URL returns a 401 that looks exactly like a typo.
#
# A lane with neither URL nor secret is simply not configured. Routing checks
# before it plans, names the missing lane in words, and starts nothing. There
# is no fallback from one lane to another: an unconfigured lane never silently
# borrows a different workflow's deployment.
#
# _TRIGGER_URL is the whole URL copied from the workflow's Integrate tab. It
# may or may not already end in /trigger; both are accepted. _DEPLOYMENT_ID is
# the alternative when you have only the id — set one or the other, not both.

# UNDERSTAND — reads the record and answers in words.
YOXA_UNDERSTAND_TRIGGER_URL=
YOXA_UNDERSTAND_DEPLOYMENT_SECRET=
YOXA_UNDERSTAND_DEPLOYMENT_ID=

# PRODUCE — drafts a document from material another run retrieved. Never runs
# on a cold question: without UNDERSTAND configured, a document request is
# refused rather than started.
YOXA_PRODUCE_TRIGGER_URL=
YOXA_PRODUCE_DEPLOYMENT_SECRET=
YOXA_PRODUCE_DEPLOYMENT_ID=

# CHAT — retrieves and replies. Serves both the replay path and direct lookups.
YOXA_CHAT_TRIGGER_URL=
YOXA_CHAT_DEPLOYMENT_SECRET=
YOXA_CHAT_DEPLOYMENT_ID=

# FIFTEEN — the full governed pipeline, for a formal document leaving the care
# team. Its variables predate the per-lane naming, so the plain YOXA_ names are
# its: they are the fifteen-step lane and nothing else.
YOXA_TRIGGER_URL=
YOXA_DEPLOYMENT_SECRET=
YOXA_DEPLOYMENT_ID=

# ---------------------------------------------------------- connector token
#
# The bearer token Yoxa presents to the Edge Functions its connectors call.
# Generate with `openssl rand -hex 32`, set it as a function secret, and paste
# the same value into each connector's configuration in Yoxa after upload.
# Every connector-facing function verifies it itself, which is why verify_jwt
# is off for them in supabase/config.toml.
YOXA_CONNECTOR_TOKEN=

# The header Yoxa presents it in, if it is not the default Authorization
# bearer. Leave empty unless a connection check says otherwise.
YOXA_SECRET_HEADER=

# ------------------------------------------------- human approvals (HITL)
#
# Yoxa posts signed approval events to hitl-receiver, which verifies the HMAC
# over the raw body before parsing anything. ORCA shows the decision in its own
# interface and hitl-respond posts the human's choice back.
#
# One signing secret per deployment that raises approvals. The plain name is
# the primary; the numbered and comma-separated forms are also accepted, so a
# second deployment can be added without renaming the first.
YOXA_HITL_WEBHOOK_SIGNING_SECRET=
YOXA_HITL_WEBHOOK_SIGNING_SECRET_2=
YOXA_HITL_WEBHOOK_SIGNING_SECRET_3=
YOXA_HITL_WEBHOOK_SIGNING_SECRETS=

# Responding. The singular name is the fallback for a single deployment; the
# plural takes a JSON object keyed by deployment id when several raise
# approvals.
YOXA_HITL_RESPONSE_SECRET=
YOXA_HITL_RESPONSE_SECRETS=

# ---------------------------------------------------------------- the rest

# Yoxa's origin, used to build a trigger URL from a bare deployment id.
# Leave empty for the default (https://yoxa.ai).
YOXA_ORIGIN=

# DEMO BOUNDARY. ORCA has no sign-in yet, so with this set to 'true' the
# frontend may assert which actor it is acting as instead of proving it. Scope
# is still enforced server-side either way — mayActOnPatient runs regardless —
# but identity is asserted rather than verified.
#
# Unset it, and turn verify_jwt back on in supabase/config.toml, the day
# Supabase Auth lands. Neither function's logic changes.
ORCA_DEMO_MODE=

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected into every Edge
# Function by the platform. Do not set them yourself, and never put the
# service_role key anywhere the browser can reach.
