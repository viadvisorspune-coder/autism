# Copy to .env and fill in locally, or set these in your hosting provider's
# server-side secret manager. .env is gitignored — never commit real values.
#
# Everything here is server-side only EXCEPT the two NEXT_PUBLIC_ Supabase
# values at the bottom, which are sent to the browser by design. No secret may
# ever be given a NEXT_PUBLIC_ prefix.

# --- Database -------------------------------------------------------------
# Supabase transaction-pooler connection string (port 6543), not the direct
# connection: serverless functions exhaust direct connections under load.
DATABASE_URL=

# --- Yoxa: this app calling Yoxa -----------------------------------------
# Copy YOXA_TRIGGER_URL verbatim from Yoxa's Release -> Integration screen.
# It contains the deployment-specific path; do not reconstruct it by hand.
# The HITL response origin is derived from this URL, so no separate base is set.
YOXA_TRIGGER_URL=
YOXA_DEPLOYMENT_SECRET=

# --- Yoxa: Yoxa calling this app -----------------------------------------
# Bearer token Yoxa sends to the /api/yoxa/* connector endpoints. Generate a
# random value, store it here, and enter the same value in Yoxa's connector
# configuration after uploading each OpenAPI file.
YOXA_CONNECTOR_TOKEN=

# --- Yoxa: deployed human-in-the-loop approvals ---------------------------
# Verifies the signature on approval events Yoxa sends to /api/yoxa/hitl.
YOXA_HITL_WEBHOOK_SIGNING_SECRET=
# Authenticates this app when it sends the human's decision back to Yoxa.
YOXA_HITL_RESPONSE_SECRET=

# --- Application ----------------------------------------------------------
# Public origin of this deployment, e.g. https://orca.example.com
APP_URL=

# --- Supabase -------------------------------------------------------------
# The URL and publishable key are public: they are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The service-role key bypasses Row Level Security. Server-side only, never
# prefixed NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=
