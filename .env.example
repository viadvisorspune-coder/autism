# Copy to .env.local and fill in from your Supabase project settings.
# Both values are public by design — they ship in the browser bundle, and
# row-level security is what enforces who can read what.
# Never put the service_role key in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Yoxa — SERVER-ONLY. Never prefixed with VITE_, never read from browser code.
# Leave empty here; set real values in the hosting platform's environment.
YOXA_TRIGGER_URL=
YOXA_DEPLOYMENT_SECRET=

# A second deployment, for the conversational workflow. Each Yoxa deployment
# has its own URL and its own secret — they are never interchangeable. Leave
# both empty and every lane goes to the deployment above, which is a working
# configuration rather than a broken one.
YOXA_CHAT_TRIGGER_URL=
YOXA_CHAT_DEPLOYMENT_SECRET=

# Connector token Yoxa presents to the Edge Functions. Generate one with
# `openssl rand -hex 32`, set it as a Supabase function secret, and paste the
# same value into each connector's Yoxa configuration after upload.
YOXA_CONNECTOR_TOKEN=

# Deployed human-in-the-loop. Server-only, set in the hosting secret manager.
YOXA_HITL_WEBHOOK_SIGNING_SECRET=
YOXA_HITL_RESPONSE_SECRET=
