# Secrets the Edge Functions read at runtime. Copy to supabase/.env.functions,
# fill in, then apply with:
#
#   supabase secrets set --env-file supabase/.env.functions
#
# supabase/.env.functions is gitignored. Never commit real values.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform —
# do not set them here.

# The token Yoxa presents to every connector function. The functions verify it
# themselves, which is why verify_jwt is off for them in config.toml.
# Generate with: openssl rand -hex 32
YOXA_CONNECTOR_TOKEN=

# Header the connector token arrives in. Leave unset for the default.
YOXA_SECRET_HEADER=

# The workflow deployment. Each Yoxa deployment has its own URL and its own
# secret; they are never interchangeable.
YOXA_TRIGGER_URL=
YOXA_DEPLOYMENT_SECRET=

# The conversational deployment. Leave both empty and every lane falls back to
# the deployment above, which is a working configuration rather than a broken one.
YOXA_CHAT_TRIGGER_URL=
YOXA_CHAT_DEPLOYMENT_SECRET=

# Human-in-the-loop. hitl-receiver verifies the signature on inbound events;
# hitl-respond signs the reply.
YOXA_HITL_WEBHOOK_SIGNING_SECRET=
YOXA_HITL_RESPONSE_SECRET=

# Set to 1 only while there is no sign-in: it lets workflow-trigger accept an
# asserted actor_id instead of a real session. Scope is still enforced. Unset
# it the day Supabase Auth lands.
ORCA_DEMO_MODE=
